# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=
# Server-only Mapbox token (URL-restriction off, used for Search Box API proxy).
# Generate a separate secret token from the Mapbox account dashboard.
MAPBOX_SERVER_TOKEN=

# Google Places API (server-only)
GOOGLE_PLACES_API_KEY=

# API Key Encryption (required)
ENCRYPTION_SECRET=

# DataForSEO API
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Claude API (server-only) — every AI feature: the assistant, place profiles,
# the Instagram import's reading. Get a key from https://console.anthropic.com
# When this is unset, the assistant and the Settings AI switch are off, profiles
# aren't written and the Instagram import is refused (503).
ANTHROPIC_API_KEY=

# HikerAPI (server-only) — reads Instagram posts and profiles for the Instagram import.
# When unset, POST /api/instagram/import returns 503. Also used by `npm run eval:instagram`.
HIKERAPI_KEY=

# Owners (server-only) — comma-separated e-mails of the accounts that may use the
# assistant (in the app and through Claude) and receive notifications. Unset: nobody.
ASSISTANT_OWNER_EMAILS=

# Resend (server-only) — the app's e-mail (Phase 3): the address confirmation,
# Settings' test, "Send to me". Key: resend.com → API Keys (sending access is
# enough). EMAIL_FROM is an address on the verified domain, e.g. hello@mappy.site
# (sent as "Map Organiser <hello@mappy.site>"), or "Name <address>".
# When either is unset, Settings says e-mail isn't set up and nothing is sent.
RESEND_API_KEY=
EMAIL_FROM=

# Telegram bot (server-only, production only — a bot has one webhook address).
# Token from @BotFather; the username without or with the @; the webhook secret
# generated with `openssl rand -hex 32` and given to setWebhook as secret_token.
# When the token or username is unset, Settings says Telegram isn't set up.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Langfuse (server-only) — LLM observability (traces for every Claude call).
# Keys: cloud.langfuse.com → Settings → API Keys. EU data region.
# When unset, the Langfuse span processor is skipped entirely (no-op).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
